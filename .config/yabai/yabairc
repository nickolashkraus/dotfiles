#!/usr/bin/env bash
###############################################################################
# yabai Configuration
#
# DESCRIPTION
#   Configuration file for yabai.
#
#   yabai is a tiling window manager for macOS that brings advanced window
#   control and layout capabilities to the macOS desktop—similar to what you'd
#   find on Linux with tools like i3 or bspwm.
#
#   See: https://github.com/koekeishiya/yabai
#
# INSTALLATION
#   Symlink file to $XDG_CONFIG_HOME/yabai/yabairc:
#
#     ln -s .config/yabai/yabairc $XDG_CONFIG_HOME/yabai/yabairc
#
#   yabai uses the macOS Mach APIs to inject code into Dock.app; this requires
#   elevated (root) privileges. You can configure your user to execute
#   `yabai --load-sa` as the root user without having to enter a password by
#   adding a rule to the sudoers configuration:
#
#     $ sudo visudo -f /private/etc/sudoers.d/yabai
#
#     ```
#     <user> ALL=(root) NOPASSWD: $(brew --prefix)/bin/yabai --load-sa
#     ```
#
#   See: https://github.com/koekeishiya/yabai/wiki/Installing-yabai-(latest-release)
###############################################################################

# NOTE: Loading the scripting addition requires SIP to be partially disabled.
sudo yabai --load-sa
yabai -m signal --add event=dock_did_restart action="sudo yabai --load-sa"

# Reload yabai when displays are added or removed.
yabai -m signal --add event=display_added action="yabai --restart-service"
yabai -m signal --add event=display_removed action="yabai --restart-service"

display_count=$(yabai -m query --displays | jq 'length')

###############################################################################
# Appearance
###############################################################################
yabai -m config active_window_opacity         1.0
yabai -m config normal_window_opacity         1.0
yabai -m config window_opacity                off
yabai -m config window_opacity_duration       0.0
yabai -m config window_origin_display         default
yabai -m config window_shadow                 off
yabai -m config external_bar                  all:-12:12
yabai -m config menubar_opacity               0.0

###############################################################################
# Layout & Placement
###############################################################################
yabai -m config auto_balance                  off
yabai -m config layout                        bsp
yabai -m config split_ratio                   0.5
yabai -m config window_placement              second_child

###############################################################################
# Padding & Gaps
###############################################################################
yabai -m config top_padding                   6
yabai -m config bottom_padding                12
yabai -m config left_padding                  12
yabai -m config right_padding                 12
yabai -m config window_gap                    8

###############################################################################
# Mouse Controls
###############################################################################
yabai -m config mouse_modifier                fn
yabai -m config mouse_action1                 move
yabai -m config mouse_action2                 resize
yabai -m config mouse_drop_action             swap

###############################################################################
# Focus Behavior
###############################################################################
yabai -m config focus_follows_mouse           off
yabai -m config mouse_follows_focus           off

###############################################################################
# Feedback
###############################################################################
yabai -m config insert_feedback_color         0xff504945  # Gruvbox: dark2

###############################################################################
# Animation
# NOTE: Only effective if scripting addition is loaded.
###############################################################################
yabai -m config window_animation_duration     0.0

###############################################################################
# Debug
###############################################################################
yabai -m config debug_output                  off

###############################################################################
# Rules
# Grid Format: <rows>:<cols>:<start-x>:<start-y>:<width>:<height>
###############################################################################
if [ "$display_count" -gt 1 ]; then
  # Do not force a display on iTerm2. Restored windows must stay on whichever
  # display they were placed on; a display property here re-yanks them on every
  # yabai restart (login, dock handshake, display wake). The catch-all rule
  # excludes iTerm2 so its display=^2 does not capture it instead.
  yabai -m rule --add app!="^iTerm2$"         manage=off display=^2 sub-layer=below grid=24:12:2:6:8:12
  yabai -m rule --add app="^iTerm2$"          manage=on
  yabai -m rule --add app="^System Settings$" manage=off display=^2 sub-layer=below grid=12:24:0:0:0:6
else
  yabai -m rule --add app=".*"                manage=off sub-layer=normal grid=20:20:1:1:18:18
  yabai -m rule --add app="^iTerm2$"          manage=off sub-layer=normal grid=1:1:0:0:1:1
  yabai -m rule --add app="^System Settings$" manage=off sub-layer=normal grid=12:24:0:0:0:6
fi

# Re-apply rules to existing windows. A rule only auto-matches windows created
# after it is added, so on (re)start already-open floating windows (Firefox,
# Slack) keep stale placement and sub-layer until the rules are re-applied.
# This ran only in the undocked branch before, so a docked restart left Firefox
# uncaptured (sub-layer=normal instead of below) and the raise/cycle shortcuts
# misbehaved. Run it in both layouts.
yabai -m rule --apply

###############################################################################
# JankyBorders
###############################################################################
borders &
