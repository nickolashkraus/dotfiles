###############################################################################
# LaunchAgents
#
# Each agent is linked into ~/Library/LaunchAgents, then booted out and back
# in. launchd loads the agent at every login; bootstrapping here starts it
# without waiting for the next login, and the bootout handles the upgrade case,
# since launchd caches the job definition and an edit to the plist stays inert
# until the job is reloaded.
#
# `io.nickolaskraus.system-update` runs `system-update` daily at 08:00. The job
# redirects its own output rather than using StandardOutPath, so the log
# directory must exist before it fires. `system-update` lives in the
# bash-scripts repo and reaches this machine via a ~/bin symlink, so it is not
# guaranteed to be present. A missing script is a warning rather than a hard
# failure: the agent is still installed and starts working once bash-scripts is
# set up.
#
# `io.nickolaskraus.caffeinate` keeps the machine awake so background agents
# survive reboots.
#
# Required Files:
#   * Library/LaunchAgents/io.nickolaskraus.system-update.plist
#   * Library/LaunchAgents/io.nickolaskraus.caffeinate.plist
###############################################################################
check_file_exists "${dotfiles}/Library/LaunchAgents/io.nickolaskraus.system-update.plist" || exit 1
check_file_exists "${dotfiles}/Library/LaunchAgents/io.nickolaskraus.caffeinate.plist" || exit 1
mkdir -p "${HOME}/Library/LaunchAgents"

if [[ ! -x "${HOME}/bin/system-update" ]]; then
  echo -e "${yellow}WARNING: ${HOME}/bin/system-update not found.${reset}" >&2
  echo -e "${yellow}io.nickolaskraus.system-update will fail until bash-scripts is installed.${reset}" >&2
fi
mkdir -p "${HOME}/.local/state"
rm -f "${HOME}/Library/LaunchAgents/io.nickolaskraus.system-update.plist" || true
run ln -s "${dotfiles}/Library/LaunchAgents/io.nickolaskraus.system-update.plist" \
  "${HOME}/Library/LaunchAgents/io.nickolaskraus.system-update.plist"
# `system-update` runs this script from inside the agent below, and booting out
# a job kills its process tree. Reloading here would terminate this run before
# any of the sections below it, so the daily job skips the reload and picks up
# a changed plist at the next login. The agent sets SYSTEM_UPDATE_AGENT; an
# interactive run does not have it and reloads normally.
if [[ -z "${SYSTEM_UPDATE_AGENT:-}" ]]; then
  launchctl bootout "gui/$(id -u)/io.nickolaskraus.system-update" 2>/dev/null || true
  run launchctl bootstrap "gui/$(id -u)" \
    "${HOME}/Library/LaunchAgents/io.nickolaskraus.system-update.plist"
fi

rm -f "${HOME}/Library/LaunchAgents/io.nickolaskraus.caffeinate.plist" || true
run ln -s "${dotfiles}/Library/LaunchAgents/io.nickolaskraus.caffeinate.plist" \
  "${HOME}/Library/LaunchAgents/io.nickolaskraus.caffeinate.plist"
launchctl bootout "gui/$(id -u)/io.nickolaskraus.caffeinate" 2>/dev/null || true
run launchctl bootstrap "gui/$(id -u)" \
  "${HOME}/Library/LaunchAgents/io.nickolaskraus.caffeinate.plist"

