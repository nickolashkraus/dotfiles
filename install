###############################################################################
# Brewfile (Homebrew Packages)
#
# `brew bundle` upgrades outdated entries by default, which is what the
# explicit `brew upgrade` below already does for formulae and casks. It also
# reaches Mac App Store entries, where `mas upgrade` re-execs itself under
# `sudo` and so cannot run without a TTY: the daily launchd job fails on every
# outdated App Store app. `--no-upgrade` reduces `brew bundle` to installing
# what is missing and leaves upgrades to `brew upgrade`. App Store apps update
# themselves through the App Store's own automatic updates.
#
# Required Files:
#   * Brewfile
###############################################################################
echo -e "${white}####################################################################${reset}" >&2
echo -e "${white}Installing and upgrading Homebrew packages...${reset}" >&2
echo -e "${white}####################################################################${reset}" >&2
check_file_exists "${dotfiles}/Brewfile" || exit 1
check_command_exists "brew" || exit 1
# Homebrew 6.0.0 requires non-official taps to be explicitly trusted before
# their formulae and casks can be loaded. Trust every tap the Brewfile declares
# so `brew bundle` does not skip them.
# The loop reads from a process substitution rather than a pipe so it runs in
# this shell: a `run` inside a pipeline's subshell could not record a failure.
while read -r _tap; do
  run brew trust --tap "${_tap}"
done < <(grep '^tap "' "${dotfiles}/Brewfile" | sed -E 's/^tap "([^"]+)".*/\1/')
run brew update
run brew bundle --file="${dotfiles}/Brewfile" --no-upgrade
run brew upgrade
echo -e "${green}Done!\n${reset}" >&2

###############################################################################
# Python Packages
#
# NOTE: pipx has effectively become the de facto standard for managing global
# Python CLI tools in 2025.
#
# `pipx install` is a no-op for an already-installed package, so
# `pipx upgrade-all` follows to move everything to the latest version.
###############################################################################
echo -e "${white}####################################################################${reset}" >&2
echo -e "${white}Installing and upgrading Python packages...${reset}" >&2
echo -e "${white}####################################################################${reset}" >&2
check_command_exists "pipx" || exit 1
run pipx ensurepath
run pipx install powerline-status
run pipx install ruff
run pipx install ty
run pipx install mypy
run pipx install poetry
run pipx upgrade-all
echo -e "${green}Done!\n${reset}" >&2

###############################################################################
# Go Binaries
#
# The `@latest` suffix makes each install an upgrade when the binary is already
# present.
###############################################################################
echo -e "${white}####################################################################${reset}" >&2
echo -e "${white}Installing and upgrading Go binaries...${reset}" >&2
echo -e "${white}####################################################################${reset}" >&2
check_command_exists "go" || exit 1
run go install golang.org/x/tools/cmd/goimports@latest
run go install github.com/golangci/golangci-lint/cmd/golangci-lint@latest
run go install go.uber.org/mock/mockgen@latest
echo -e "${green}Done!\n${reset}" >&2

###############################################################################
# npm Packages
#
# `npm install -g` resolves to the latest published version, so each install is
# an upgrade when the package is already present.
###############################################################################
echo -e "${white}####################################################################${reset}" >&2
echo -e "${white}Installing and upgrading npm packages...${reset}" >&2
echo -e "${white}####################################################################${reset}" >&2
check_command_exists "npm" || exit 1
run npm install -g @google/gemini-cli
run npm install -g @openai/codex
run npm install -g cspell
run npm install -g eslint
run npm install -g prettier
run npm install -g sort-package-json
run npm install -g typescript
echo -e "${green}Done!\n${reset}" >&2

###############################################################################
# Claude Code
#
# Claude Code is installed via the native installer, the officially
# recommended method. Unlike the Homebrew cask, the native install
# auto-updates in the background. The installer is idempotent and
# updates an existing installation in place.
#
# See: https://code.claude.com/docs/en/setup
###############################################################################
echo -e "${white}####################################################################${reset}" >&2
echo -e "${white}Installing Claude Code...${reset}" >&2
echo -e "${white}####################################################################${reset}" >&2
check_command_exists "curl" || exit 1
# `run` takes a command, not a pipeline, so the installer gets a name.
# The indirect call through `run` is invisible to shellcheck, hence the
# directive below.
# shellcheck disable=SC2329
function install_claude_code() {
  curl -fsSL https://claude.ai/install.sh | bash
}
run install_claude_code
echo -e "${green}Done!\n${reset}" >&2

if [[ ${failures} -ne 0 ]]; then
  echo -e "${red}install: complete, ${failures} failure(s)${reset}" >&2
else
  echo -e "${green}install: complete, 0 failures${reset}" >&2
fi

exit "${failures}"
